        "text": "=Ticket {{ $('Get JIRA Tickets').item.json.key }}\nSummary: {{ $('Get JIRA Tickets').item.json.fields.summary }}\nDescription: {{ $('Get JIRA Tickets').item.json.fields.description }}\n\nKnowledge base articles found for this ticket:\n{{ $json.results.length ? $json.results.map(a => '### ' + a.title + '\\n' + a.body.storage.value).join('\\n\\n') : 'None found.' }}\n",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are an assistant for an IT service desk team. For each ticket you suggest troubleshooting steps for the service desk agent, based on the company knowledge base. You only give advice: never say or imply that anything has been done.  Knowledge base articles found by a search are included with the ticket. Some may not be relevant: use only the ones that match the ticket. Take troubleshooting steps ONLY from those articles, not from general knowledge. If no article fits, leave troubleshooting_steps and kb_articles_used empty.  confidence: a number from 0 to 1 for how well the knowledge base articles fit this ticket.  Write for experienced IT staff: precise, professional and concise."
            }
          ]
        },
